{
  "functions": {
    "api/webhook.js": {
      "maxDuration": 120,
      "includeFiles": "promts.md"
    },
    "api/webhook/[token].js": {
      "maxDuration": 120,
      "includeFiles": "promts.md"
    },
    "api/setup.js": {
      "maxDuration": 60
    },
    "api/finance-due-reminders.js": {
      "maxDuration": 60
    },
    "api/nudge-check.js": {
      "maxDuration": 60
    }
  },
  "crons": [{"path":"/api/documental-check","schedule":"*/10 * * * *"}],
  "rewrites": [
    {
      "source": "/",
      "destination": "/index.html"
    }
  ]
}
