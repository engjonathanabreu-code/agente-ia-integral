{
  "functions": {
    "api/webhook.js": {
      "maxDuration": 60,
      "includeFiles": "promts.md"
    },
    "api/webhook/[token].js": {
      "maxDuration": 60,
      "includeFiles": "promts.md"
    },
    "api/setup.js": {
      "maxDuration": 60
    },
    "api/finance-due-reminders.js": {
      "maxDuration": 60
    }
  },
  "crons": [
    {
      "path": "/api/finance-due-reminders",
      "schedule": "0 12 * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/",
      "destination": "/index.html"
    }
  ]
}
